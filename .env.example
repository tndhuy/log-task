# EOFFICE_BASE_URL is the origin only (scheme and host), no path.
EOFFICE_BASE_URL=https://eoffice-uat.example.vn
EOFFICE_ACCESS_TOKEN=
# Optional: browser session cookie for the progress-report record. Pass it inline per run; do not store it.
# EOFFICE_SESSION_COOKIE=
# Or pass --session-from brave (or chrome) to create --apply instead.
# Optional: comma-separated exact hosts treated as UAT (default eoffice-uat.novagroup.vn).
# EOFFICE_UAT_HOSTS=
