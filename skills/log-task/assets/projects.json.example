{
  "/absolute/path/to/lark/project": {
    "platform": "lark",
    "gitEmails": [
      "you@example.com"
    ],
    "params": {
      "baseToken": "<base token>",
      "tableId": "<table id>",
      "prefix": "[Project]",
      "fieldMap": {}
    }
  },
  "/absolute/path/to/nova-api-group-root": {
    "type": "group",
    "platform": "eoffice-api",
    "gitEmails": [
      "you@example.com"
    ],
    "logDir": ".log-task",
    "children": {
      "one-nova-be": {
        "params": {
          "project": "<eOffice project name>",
          "projectRef": "<project code (verified on UAT)>",
          "projectId": "<raw project ID>"
        },
        "rules": {
          "nameTemplate": "[NVG.ITD - CDS Tập Đoàn] - One Nova - {layer} - {summary}",
          "layer": {
            "mode": "fixed",
            "value": "BE"
          },
          "parent": {
            "mode": "ask",
            "remember": true,
            "candidates": [
              {
                "id": 2089469,
                "label": "OneNova -P5- Development"
              },
              {
                "id": 2087612,
                "label": "05. One Nova - Phase 5 CDS thư ký - Điểm danh cuộc họp"
              }
            ]
          },
          "owner": {
            "mode": "ask",
            "default": "<your username>",
            "remember": true
          },
          "assignees": {
            "mode": "ask",
            "default": [
              "<your username>",
              "<colleague username>"
            ],
            "remember": true
          },
          "followers": {
            "mode": "fixed",
            "value": []
          },
          "dates": {
            "actualFromPlan": true
          },
          "done": {
            "status": "REVIEW"
          }
        }
      }
    }
  },
  "/absolute/path/to/manual/project": {
    "platform": "manual",
    "gitEmails": [
      "you@example.com"
    ],
    "params": {}
  }
}
